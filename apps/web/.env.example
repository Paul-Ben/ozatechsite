# Copy to .env.local for development. Never commit the filled-in file.

# Public site URL — used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API base URL. SERVER-SIDE ONLY — deliberately not NEXT_PUBLIC_,
# so the browser never talks to Laravel directly.
# Local:      http://localhost:8000
# Railway:    http://api.railway.internal:8080   (private network)
API_URL=http://localhost:8000

# Shared secret for the CMS -> Next.js revalidation webhook.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Public hostname of the Laravel `api` service, which serves uploaded media
# from /storage/... (backed by a Railway Volume). Used to allow-list the host
# for next/image. Hostname only — no protocol, no trailing slash.
# e.g. api.ozatech.co.uk
# Leave empty until the backend exists.
MEDIA_HOST=
